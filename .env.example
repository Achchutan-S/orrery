# Build environment: development | preview | production.
# Vercel sets this automatically. Unset means development (drafts mounted).
# Astro does not load .env into the config, so export it in the shell:
#   VERCEL_ENV=production pnpm build
VERCEL_ENV=

# Set by Vercel. Origin for canonical URLs; unset means http://localhost:4321.
VERCEL_PROJECT_PRODUCTION_URL=

# Set by the Vercel build command (apps/site/vercel.json). With it, a missing VERCEL_ENV fails the build.
PU_DEPLOYMENT=

# Optional, for `pnpm smoke` against a protected preview. Never commit a value.
VERCEL_AUTOMATION_BYPASS_SECRET=
