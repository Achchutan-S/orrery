{
  "$schema": "./release.schema.json",
  "platform": {
    "flags": {}
  },
  "experiences": {
    "canary-draft": {
      "lifecycle": "draft",
      "access": {
        "kind": "owner"
      },
      "discoverability": "unlisted",
      "note": "Permanent leak-check canary. Never promote: production builds must not contain it."
    },
    "devxray": {
      "lifecycle": "published",
      "access": {
        "kind": "public"
      },
      "discoverability": "listed",
      "note": "Independent project at devxray-one.vercel.app; linked, never built here."
    },
    "journal": {
      "lifecycle": "published",
      "access": {
        "kind": "public"
      },
      "discoverability": "listed",
      "note": "Unpublish by setting access to owner (or lifecycle draft); hide from discovery with discoverability unlisted. Content stays in the repository either way."
    },
    "kawaiui": {
      "lifecycle": "published",
      "access": {
        "kind": "public"
      },
      "discoverability": "listed",
      "note": "Independent project at kawaiui.vercel.app; linked, never built here."
    },
    "sample-app": {
      "lifecycle": "published",
      "access": {
        "kind": "public"
      },
      "discoverability": "listed",
      "flags": {
        "inspector": {
          "preview": true,
          "production": false
        }
      }
    },
    "sample-content": {
      "lifecycle": "published",
      "access": {
        "kind": "public"
      },
      "discoverability": "listed"
    },
    "sample-hostile": {
      "lifecycle": "draft",
      "access": {
        "kind": "owner"
      },
      "discoverability": "unlisted",
      "note": "Permanent CSS isolation fixture. Never promote."
    }
  }
}
