{
  "name": "personal-universe",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "pnpm --filter @pu/site dev",
    "control": "pnpm --filter @pu/control start",
    "control:server": "pnpm --filter @pu/control dev",
    "build": "pnpm --filter @pu/site build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "gen:release-schema": "node tools/checks/src/release-schema.ts config/release.schema.json",
    "test:browser": "pnpm --filter @pu/site test:browser && pnpm --filter @pu/control test:browser",
    "build:production": "VERCEL_ENV=production pnpm --filter @pu/site build",
    "check": "pnpm check:boundaries && pnpm build:production && pnpm check:metadata && pnpm check:leaks && pnpm check:budgets",
    "check:boundaries": "node tools/checks/src/boundaries.ts",
    "check:metadata": "node tools/checks/src/metadata.ts apps/site/dist",
    "check:leaks": "node tools/checks/src/leaks.ts apps/site/dist",
    "check:budgets": "node tools/checks/src/budgets.ts apps/site/dist",
    "smoke": "node tools/checks/src/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
