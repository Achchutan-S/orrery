---
// The resume's presentation: a typeset dossier. Section labels and dates sit in a margin column,
// the text in a measured column beside them. Set entirely in the platform face, so the PDF made
// from this page embeds the same font on any machine. Prints to A4 (the PDF is this page printed).
import { Font } from 'astro:assets';
import ExperienceRoot from '../../platform/root/ExperienceRoot.astro';

interface Props { title: string; description: string }
---
<ExperienceRoot experience="resume" title={Astro.props.title} description={Astro.props.description}>
  <Font slot="head" cssVariable="--font-platform" preload />
  <slot />
</ExperienceRoot>

<style is:global>
  @layer experience {
    [data-experience='resume'] {
      --r-paper: light-dark(#fbfaf6, #121416);
      --r-ink: light-dark(#14171a, #e9e7e1);
      --r-muted: light-dark(#50565c, #a5abb0);
      --r-rule: light-dark(#d9d6cc, #2e3236);
      --r-accent: light-dark(#1d4e89, #8fb4e8);
      --r-margin: 10.5rem;
      background: var(--r-paper);
    }

    [data-experience='resume'] body {
      color: var(--r-ink);
      background: var(--r-paper);
      font-family: var(--font-platform), system-ui, sans-serif;
      font-size: 1rem;
      line-height: 1.55;
      font-variant-numeric: tabular-nums;
      text-size-adjust: 100%;
    }

    [data-experience='resume'] .dossier {
      max-inline-size: 58rem;
      margin-inline: auto;
      padding: var(--pu-space-5) clamp(1rem, 4vw, 3rem) var(--pu-space-4);
    }

    [data-experience='resume'] a {
      color: var(--r-accent);
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
      overflow-wrap: anywhere;
    }

    [data-experience='resume'] a:hover { text-decoration-thickness: 2px; }
    [data-experience='resume'] p { margin: 0; }
    [data-experience='resume'] ul,
    [data-experience='resume'] ol { margin: 0; padding: 0; list-style: none; }

    /* ---- Head ---- */

    [data-experience='resume'] .head {
      display: grid;
      gap: var(--pu-space-2);
      padding-block-end: var(--pu-space-4);
      border-block-end: 2px solid var(--r-ink);
    }

    [data-experience='resume'] .kicker {
      color: var(--r-accent);
      font-size: 0.875rem;
      font-variant-caps: all-small-caps;
      letter-spacing: 0.1em;
      font-weight: 700;
    }

    [data-experience='resume'] h1 {
      margin: 0;
      font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.25rem);
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.02em;
    }

    [data-experience='resume'] .role { color: var(--r-muted); font-size: 1.25rem; }
    [data-experience='resume'] .focus { font-size: 1rem; }

    [data-experience='resume'] .visually-hidden {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    [data-experience='resume'] .links {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--pu-space-4);
      margin-block-start: var(--pu-space-2);
    }

    [data-experience='resume'] .links .label { color: var(--r-muted); margin-inline-end: 0.4em; }

    /* Inline links get vertical padding: a 44px target without moving the layout. */
    [data-experience='resume'] .links a,
    [data-experience='resume'] .project-links a {
      padding-block: max(0.3em, 10px);
      box-decoration-break: clone;
    }

    [data-experience='resume'] .download {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--pu-space-1) var(--pu-space-3);
      margin-block-start: var(--pu-space-2);
    }

    [data-experience='resume'] .download a {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--pu-target-min);
      padding: 0 1rem;
      border: 1.5px solid var(--r-accent);
      border-radius: 3px;
      font-weight: 700;
      text-decoration: none;
    }

    [data-experience='resume'] .download a:hover { background: var(--r-accent); color: var(--r-paper); }
    [data-experience='resume'] .download .meta { color: var(--r-muted); font-size: 0.875rem; }

    /* ---- Sections: label in the margin, text beside it ---- */

    [data-experience='resume'] .part {
      display: grid;
      gap: var(--pu-space-2) var(--pu-space-4);
      padding-block: var(--pu-space-4);
      border-block-end: 1px solid var(--r-rule);
    }

    @media (min-width: 46rem) {
      [data-experience='resume'] .part { grid-template-columns: var(--r-margin) minmax(0, 1fr); }
    }

    [data-experience='resume'] h2 {
      margin: 0;
      color: var(--r-accent);
      font-size: 1rem;
      font-variant-caps: all-small-caps;
      letter-spacing: 0.1em;
      line-height: 1.55;
    }

    [data-experience='resume'] .body { display: grid; gap: var(--pu-space-4); max-inline-size: 40rem; }
    [data-experience='resume'] .stack { display: grid; gap: var(--pu-space-4); }
    [data-experience='resume'] .summary { font-size: 1.0625rem; }

    [data-experience='resume'] .entry { display: grid; gap: var(--pu-space-1); }
    [data-experience='resume'] h3 { margin: 0; font-size: 1.125rem; line-height: 1.3; }
    [data-experience='resume'] h3 .org { font-weight: 400; }
    [data-experience='resume'] .when,
    [data-experience='resume'] .kind { color: var(--r-muted); font-size: 0.875rem; }

    [data-experience='resume'] .points { display: grid; gap: 0.3rem; margin-block-start: 0.25rem; }
    [data-experience='resume'] .points li { position: relative; padding-inline-start: 1rem; }
    [data-experience='resume'] .points li::before {
      content: '';
      position: absolute;
      inset-inline-start: 0.1rem;
      inset-block-start: 0.7em;
      inline-size: 0.4rem;
      block-size: 1px;
      background: var(--r-muted);
    }

    [data-experience='resume'] h4 { margin: var(--pu-space-2) 0 0; font-size: 0.9375rem; color: var(--r-muted); }
    [data-experience='resume'] .points strong { font-weight: 700; }
    [data-experience='resume'] .project-links { font-size: 0.9375rem; }
    [data-experience='resume'] .project-links .label { color: var(--r-muted); }
    [data-experience='resume'] .earlier { color: var(--r-muted); font-size: 0.9375rem; }
    [data-experience='resume'] .plain { display: grid; gap: 0.15rem; }

    [data-experience='resume'] .skills { display: grid; gap: var(--pu-space-2); margin: 0; }
    [data-experience='resume'] .skills div { display: grid; gap: 0.1rem; }
    [data-experience='resume'] .skills dt { color: var(--r-muted); font-size: 0.875rem; }
    [data-experience='resume'] .skills dd { margin: 0; }

    /* The platform colophon, placed under the dossier's column. */
    [data-experience='resume'] .pu-colophon { max-inline-size: 58rem; margin-inline: auto; color: var(--r-muted); }
    [data-experience='resume'] .pu-colophon a { color: var(--r-accent); }

    /* ---- Print and the PDF: A4, light, nothing interactive ---- */

    @page { size: A4; margin: 14mm 15mm; }

    @media print {
      [data-experience='resume'] {
        --r-paper: #fff;
        --r-ink: #111;
        --r-muted: #444;
        --r-rule: #bbb;
        --r-accent: #1d4e89;
        --r-margin: 6.2rem;
        color-scheme: light;
      }

      [data-experience='resume'] body { font-size: 8.8pt; line-height: 1.33; }
      [data-experience='resume'] .summary { font-size: 9.5pt; }
      [data-experience='resume'] h3 { font-size: 10.5pt; }
      [data-experience='resume'] .when,
      [data-experience='resume'] .kind,
      [data-experience='resume'] .skills dt,
      [data-experience='resume'] .kicker,
      [data-experience='resume'] h2 { font-size: 8.5pt; }
      [data-experience='resume'] .entry { gap: 1pt; }
      [data-experience='resume'] .points { gap: 1pt; margin-block-start: 1pt; }
      [data-experience='resume'] .skills { gap: 4pt; }
      [data-experience='resume'] .links { margin-block-start: 2pt; }
      [data-experience='resume'] .dossier { max-inline-size: none; padding: 0; }
      [data-experience='resume'] .download,
      [data-experience='resume'] .pu-colophon { display: none; }
      [data-experience='resume'] h1 { font-size: 20pt; }
      [data-experience='resume'] .role { font-size: 11pt; }
      [data-experience='resume'] .head { padding-block-end: 8pt; }
      [data-experience='resume'] .part { grid-template-columns: var(--r-margin) minmax(0, 1fr); padding-block: 6pt; gap: 2pt 10pt; }
      /* Block flow, not grid, inside sections: Chromium can overlap grid items split across pages. */
      [data-experience='resume'] .body,
      [data-experience='resume'] .stack,
      [data-experience='resume'] .entry,
      [data-experience='resume'] .points,
      [data-experience='resume'] .skills,
      [data-experience='resume'] .skills div,
      [data-experience='resume'] .plain { display: block; }
      [data-experience='resume'] .body { max-inline-size: none; }
      [data-experience='resume'] .body > * + *,
      [data-experience='resume'] .stack > * + *,
      [data-experience='resume'] .skills > * + * { margin-block-start: 5pt; }
      [data-experience='resume'] .entry > * + * { margin-block-start: 1pt; }
      [data-experience='resume'] .points li + li { margin-block-start: 1pt; }
      [data-experience='resume'] .links a,
      [data-experience='resume'] .project-links a { padding-block: 0; }
      [data-experience='resume'] .focus,
      [data-experience='resume'] .project-links,
      [data-experience='resume'] .earlier { font-size: 8.5pt; }
      [data-experience='resume'] h4 { font-size: 8.5pt; margin-block-start: 3pt; }
      [data-experience='resume'] .plain { gap: 0; }
      /* Skills: label and items on one run of text, as a print resume does. */
      [data-experience='resume'] .skills dt { display: inline; color: var(--r-ink); font-weight: 700; }
      [data-experience='resume'] .skills dt::after { content: ': '; }
      [data-experience='resume'] .skills dd { display: inline; }
      [data-experience='resume'] .skills > * + * { margin-block-start: 2pt; }
      [data-experience='resume'] h2 { break-after: avoid; }
      /* Long entries may break across pages; a bullet, a heading with its first line, may not. */
      [data-experience='resume'] .points li,
      [data-experience='resume'] .project { break-inside: avoid; }
      [data-experience='resume'] h3,
      [data-experience='resume'] h4,
      [data-experience='resume'] .when { break-after: avoid; }
    }
  }
</style>
