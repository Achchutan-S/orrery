---
// One room, drawn ten ways. The geometry never changes: the same box in one-point perspective,
// a window on the back wall onto the same world (house/World.astro), a seat at the front right,
// a plant at the front left, a light from the ceiling. Each style redraws those things in its own
// language; some styles transform an object, some remove it. Original drawings for this atlas.
// `only` renders a single style (comparison pages); otherwise every style is present and CSS
// shows the chosen one. `uid` keeps SVG ids unique when two rooms share a page.
import World from '../house/World.astro';
import { archPath } from '../chapters/gothic/geometry.ts';
import './room.css';

export const STYLES = [
  'gothic', 'renaissance', 'art-nouveau', 'bauhaus', 'brutalism', 'minimalism', 'wabi-sabi', 'cyberpunk', 'frutiger-aero', 'weirdcore',
] as const;
interface Props { uid: string; only?: (typeof STYLES)[number]; label?: string }
const { uid, only, label } = Astro.props;
const show = (s: string) => !only || only === s;

const BACK = 'M230 140 H570 V390 H230Z';
const FLOOR = 'M230 390 H570 L800 560 H0Z';
const CEIL = 'M0 0 H800 L570 140 H230Z';
const LEFT = 'M0 0 L230 140 V390 L0 560Z';
const RIGHT = 'M800 0 L570 140 V390 L800 560Z';
// Window openings, one per style, all centred on the same place in the back wall.
const WIN: Record<string, string> = {
  gothic: `${archPath(300, 400, 220, 70)} L400 340 L300 340Z`,
  renaissance: 'M290 340 V230 A60 60 0 0 1 410 230 V340Z',
  'art-nouveau': 'M285 340 C 280 260, 300 190, 350 178 C 400 190, 420 260, 415 340Z',
  bauhaus: 'M250 200 H550 V300 H250Z',
  brutalism: 'M305 200 H395 V300 H305Z',
  minimalism: 'M240 160 H460 V380 H240Z',
  'wabi-sabi': 'M262 300 H372 V388 H262Z',
  cyberpunk: 'M262 180 H438 V320 H262Z',
  'frutiger-aero': 'M262 175 H438 V335 H262Z',
  weirdcore: 'M290 190 H410 V330 H290Z',
};
const id = (s: string) => `${uid}-${s}`;
---
<svg class="rf-room" viewBox="0 0 800 560" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <defs>
    <symbol id={id('world')} viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice"><World id={id('w')} /></symbol>
    {Object.entries(WIN).filter(([s]) => show(s)).map(([s, d]) => <clipPath id={id(`clip-${s}`)}><path d={d} /></clipPath>)}
    <pattern id={id('tiles')} width="40" height="40" patternUnits="userSpaceOnUse"><rect width="40" height="40" fill="#ebe5d8" /><rect width="20" height="20" fill="#8c8a83" /><rect x="20" y="20" width="20" height="20" fill="#8c8a83" /></pattern>
    <pattern id={id('board')} width="14" height="10" patternUnits="userSpaceOnUse"><rect width="14" height="10" fill="#a29e95" /><rect width="1" height="10" fill="#8d8981" /></pattern>
    <linearGradient id={id('aero-wall')} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e9f6ff" /><stop offset="1" stop-color="#ffffff" /></linearGradient>
    <linearGradient id={id('gloss')} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity="0.85" /><stop offset="0.5" stop-color="#fff" stop-opacity="0.15" /><stop offset="0.5" stop-color="#fff" stop-opacity="0" /></linearGradient>
    <linearGradient id={id('neon')} x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#ff4d6a" /><stop offset="1" stop-color="#5ee6ff" /></linearGradient>
    <filter id={id('blur')}><feGaussianBlur stdDeviation="14" /></filter>
  </defs>

  {show('gothic') && (
    <g class="rf-style rf-style--gothic">
      <path d={CEIL} fill="#1d1a22" /><path d={LEFT} fill="#3a3530" /><path d={RIGHT} fill="#332f2b" /><path d={BACK} fill="#4a443f" /><path d={FLOOR} fill="#2a2622" />
      <path d={archPath(230, 570, 140, 150)} fill="none" stroke="#7a7066" stroke-width="8" transform="translate(0 0)" />
      {[0, 1, 2, 3, 4, 5].map((i) => <line x1="230" x2="570" y1={170 + i * 40} y2={170 + i * 40} stroke="#3a3530" stroke-width="2" />)}
      <use href={`#${id('world')}`} x="270" y="140" width="160" height="200" clip-path={`url(#${id('clip-gothic')})`} opacity="0.35" />
      <g clip-path={`url(#${id('clip-gothic')})`}>{[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <rect x={300 + (i % 2) * 50} y={150 + Math.floor(i / 2) * 50} width="50" height="50" fill={['#1f3f99', '#a3182b', '#1f3f99', '#e0a630'][i % 4]} opacity="0.85" />)}</g>
      <path d={WIN.gothic} fill="none" stroke="#2a2622" stroke-width="6" />
      <line x1="350" x2="350" y1="152" y2="340" stroke="#2a2622" stroke-width="4" />
      <ellipse cx="420" cy="480" rx="120" ry="24" fill="#a3182b" opacity="0.4" filter={`url(#${id('blur')})`} /><ellipse cx="300" cy="500" rx="90" ry="20" fill="#1f3f99" opacity="0.45" filter={`url(#${id('blur')})`} />
      <path d="M600 540 V300 L645 246 L690 300 V540 M600 440 H690" fill="#4a3428" stroke="#2a1d16" stroke-width="3" />
      <path d="M130 540 V470 M110 470 H150 M130 470 l-12 -40 M130 470 l14 -44" stroke="#8a8075" stroke-width="5" fill="none" />
      <path d="M400 0 V70 M380 70 H420 L410 100 H390Z" stroke="#7a6a4a" stroke-width="3" fill="#e0a630" />
    </g>
  )}

  {show('renaissance') && (
    <g class="rf-style rf-style--renaissance">
      <path d={CEIL} fill="#efede8" /><path d={LEFT} fill="#f4f3ef" /><path d={RIGHT} fill="#ecebe6" /><path d={BACK} fill="#f8f7f3" /><path d={FLOOR} fill={`url(#${id('tiles')})`} />
      {[230, 570].map((x) => <line x1={x} x2={x} y1="140" y2="390" stroke="#5c676d" stroke-width="10" />)}
      <path d="M0 0 L230 140 M800 0 L570 140 M230 140 H570" stroke="#5c676d" stroke-width="8" fill="none" />
      {[[0, 560], [800, 560]].map(([x, y]) => <line x1={x} y1={y} x2="400" y2="265" stroke="#a33f25" stroke-width="1" opacity="0.6" />)}
      <use href={`#${id('world')}`} x="290" y="170" width="120" height="170" clip-path={`url(#${id('clip-renaissance')})`} />
      <path d={WIN.renaissance} fill="none" stroke="#5c676d" stroke-width="8" />
      <path d="M600 540 L680 430 M680 540 L600 430 M592 430 H688 M600 430 V360 H680 V430" stroke="#5a3a24" stroke-width="7" fill="none" />
      <path d="M110 540 H160 L152 500 H118Z" fill="#a8664a" /><circle cx="135" cy="470" r="30" fill="#4f6b3a" />
    </g>
  )}

  {show('art-nouveau') && (
    <g class="rf-style rf-style--art-nouveau">
      <path d={CEIL} fill="#d7e0cf" /><path d={LEFT} fill="#e4e9dc" /><path d={RIGHT} fill="#dde4d4" /><path d={BACK} fill="#eaeee2" /><path d={FLOOR} fill="#b98a5a" />
      <path d="M40 520 C 10 400, 120 360, 80 260 S 30 120, 120 80 C 160 66, 170 110, 140 120" fill="none" stroke="#1d3127" stroke-width="6" />
      <path d="M760 520 C 790 400, 680 360, 720 260 S 770 120, 680 80 C 640 66, 630 110, 660 120" fill="none" stroke="#1d3127" stroke-width="6" />
      <use href={`#${id('world')}`} x="285" y="175" width="130" height="170" clip-path={`url(#${id('clip-art-nouveau')})`} />
      <path d={WIN['art-nouveau']} fill="none" stroke="#1d3127" stroke-width="7" />
      <path d="M300 300 C 330 260, 370 330, 400 290" fill="none" stroke="#b2692a" stroke-width="4" />
      <path d="M610 540 C 600 470, 640 440, 640 380 C 640 340, 690 330, 690 380 C 690 430, 680 470, 690 540 M610 460 C 650 450, 670 470, 690 460" stroke="#3b2414" stroke-width="7" fill="none" />
      <path d="M130 540 C 120 490, 150 460, 135 420 C 130 400, 160 390, 150 380" stroke="#1d3127" stroke-width="4" fill="none" /><path d="M150 380 c -20 -20 10 -40 20 -10 c 15 -25 35 0 10 10Z" fill="#f3f2e9" stroke="#1d3127" />
      <path d="M400 0 C 395 40, 420 50, 400 80 M370 80 Q 400 130 430 80Z" stroke="#1d3127" stroke-width="3" fill="#d9a441" />
    </g>
  )}

  {show('bauhaus') && (
    <g class="rf-style rf-style--bauhaus">
      <path d={CEIL} fill="#f2f2f0" /><path d={LEFT} fill="#ffffff" /><path d={RIGHT} fill="#d2322d" /><path d={BACK} fill="#fafaf8" /><path d={FLOOR} fill="#9a9a96" />
      <use href={`#${id('world')}`} x="250" y="150" width="300" height="200" clip-path={`url(#${id('clip-bauhaus')})`} />
      <path d={WIN.bauhaus} fill="none" stroke="#000" stroke-width="6" />
      {[325, 400, 475].map((x) => <line x1={x} x2={x} y1="200" y2="300" stroke="#000" stroke-width="4" />)}
      <path d="M600 540 H690 M610 540 V470 Q 610 455 625 455 H690 M690 455 V390 M640 455 L690 410" stroke="#555" stroke-width="7" fill="none" stroke-linecap="round" />
      <rect x="104" y="480" width="56" height="60" fill="#1e4fa3" /><path d="M132 480 V420 M132 450 H116 M132 440 H148" stroke="#2f6b3a" stroke-width="8" />
      <path d="M400 0 V80" stroke="#000" stroke-width="3" /><circle cx="400" cy="100" r="22" fill="#fffbe6" stroke="#000" stroke-width="3" />
    </g>
  )}

  {show('brutalism') && (
    <g class="rf-style rf-style--brutalism">
      <path d={CEIL} fill="#6f6c66" /><path d={LEFT} fill={`url(#${id('board')})`} /><path d={RIGHT} fill="#8f8c85" /><path d={BACK} fill={`url(#${id('board')})`} /><path d={FLOOR} fill="#5a5853" />
      <path d="M290 185 H410 V315 H290Z" fill="#3b3a37" />
      <use href={`#${id('world')}`} x="305" y="200" width="90" height="100" clip-path={`url(#${id('clip-brutalism')})`} />
      <path d="M290 185 L305 200 M410 185 L395 200 M290 315 L305 300 M410 315 L395 300" stroke="#141413" stroke-width="3" />
      <path d="M310 300 L470 560 H560 L395 300Z" fill="#e9e8e4" opacity="0.35" />
      <rect x="590" y="460" width="130" height="80" fill="#a8a59e" /><rect x="590" y="460" width="130" height="10" fill="#c4c1b9" />
      <rect x="90" y="470" width="90" height="70" fill="#8f8c85" /><path d="M110 470 q 25 -50 50 0" fill="#4f6b3a" />
    </g>
  )}

  {show('minimalism') && (
    <g class="rf-style rf-style--minimalism">
      <path d={CEIL} fill="#f6f6f4" /><path d={LEFT} fill="#fbfbfa" /><path d={RIGHT} fill="#f2f2f0" /><path d={BACK} fill="#ffffff" /><path d={FLOOR} fill="#e7e5e0" />
      <use href={`#${id('world')}`} x="240" y="160" width="220" height="220" clip-path={`url(#${id('clip-minimalism')})`} />
      <path d={WIN.minimalism} fill="none" stroke="#222" stroke-width="2" />
      <path d="M620 540 V470 H690 M620 470 V420" stroke="#222" stroke-width="3" fill="none" />
    </g>
  )}

  {show('wabi-sabi') && (
    <g class="rf-style rf-style--wabi-sabi">
      <path d={CEIL} fill="#3b322b" /><path d={LEFT} fill="#4d433b" /><path d={RIGHT} fill="#463d36" /><path d={BACK} fill="#554a41" /><path d={FLOOR} fill="#8f8257" />
      <path d="M115 560 L310 390 M685 560 L490 390 M0 500 H800 M60 450 H740" stroke="#6f6440" stroke-width="2" opacity="0.7" />
      <use href={`#${id('world')}`} x="262" y="300" width="110" height="88" clip-path={`url(#${id('clip-wabi-sabi')})`} opacity="0.25" />
      <path d={WIN['wabi-sabi']} fill="#efe7d2" opacity="0.8" />
      <path d="M262 329 H372 M262 358 H372 M299 300 V388 M336 300 V388" stroke="#6b5b49" stroke-width="3" />
      <path d="M262 390 L180 560 H470 L372 390Z" fill="#efe3c6" opacity="0.12" />
      <path d="M600 520 Q 660 505 720 520 Q 725 540 660 545 Q 595 540 600 520Z" fill="#6b4b3a" />
      <path d="M470 380 C 466 360, 480 350, 476 336 M476 336 C 470 310, 450 296, 430 290" stroke="#2a221c" stroke-width="2" fill="none" /><path d="M465 390 C 460 372, 488 372, 484 390Z" fill="#5c4a3a" />
    </g>
  )}

  {show('cyberpunk') && (
    <g class="rf-style rf-style--cyberpunk">
      <path d={CEIL} fill="#0b0a12" /><path d={LEFT} fill="#14121f" /><path d={RIGHT} fill="#110f1a" /><path d={BACK} fill="#1a1726" /><path d={FLOOR} fill="#0d0c14" />
      <path d={WIN.cyberpunk} fill="#2a0f3d" />
      <rect x="272" y="190" width="156" height="120" fill="#c2185b" opacity="0.55" /><rect x="272" y="250" width="156" height="60" fill="#1e88e5" opacity="0.5" />
      <path d="M262 180 H438 V320 H262Z" fill="none" stroke={`url(#${id('neon')})`} stroke-width="4" />
      <path d="M0 0 L230 140 M800 0 L570 140" stroke="#ff5ce1" stroke-width="3" />
      <rect x="40" y="200" width="60" height="110" fill="#5ee6ff" opacity="0.25" /><rect x="700" y="230" width="70" height="40" fill="#ffb347" opacity="0.35" />
      <path d="M610 540 V480 H690 V540 M620 480 V430" stroke="#3c3852" stroke-width="6" fill="none" />
      <path d="M120 540 V500 M100 500 H140" stroke="#3c3852" stroke-width="5" /><path d="M120 500 L105 455 M120 500 L138 452" stroke="#5ee6ff" stroke-width="3" opacity="0.8" />
      <ellipse cx="400" cy="520" rx="260" ry="20" fill="#ff4d6a" opacity="0.2" filter={`url(#${id('blur')})`} />
    </g>
  )}

  {show('frutiger-aero') && (
    <g class="rf-style rf-style--frutiger-aero">
      <path d={CEIL} fill="#f4fbff" /><path d={LEFT} fill={`url(#${id('aero-wall')})`} /><path d={RIGHT} fill={`url(#${id('aero-wall')})`} /><path d={BACK} fill="#eef8ff" /><path d={FLOOR} fill="#cfe9f7" />
      <use href={`#${id('world')}`} x="262" y="175" width="176" height="160" clip-path={`url(#${id('clip-frutiger-aero')})`} />
      <rect x="262" y="175" width="176" height="160" rx="22" fill={`url(#${id('gloss')})`} stroke="#9fd4f5" stroke-width="5" />
      <path d={FLOOR} fill="#ffffff" opacity="0.35" />
      <path d="M600 540 Q 600 440 650 430 Q 700 440 700 540Z" fill="#ffffff" stroke="#9fd4f5" stroke-width="3" />
      <ellipse cx="130" cy="455" rx="44" ry="50" fill="#5fc94a" /><rect x="110" y="495" width="40" height="45" rx="10" fill="#ffffff" stroke="#9fd4f5" stroke-width="3" />
      {[[500, 120, 18], [530, 80, 12], [180, 150, 14]].map(([x, y, r]) => <circle cx={x} cy={y} r={r} fill="#ffffff" fill-opacity="0.35" stroke="#ffffff" />)}
    </g>
  )}

  {show('weirdcore') && (
    <g class="rf-style rf-style--weirdcore">
      <path d={CEIL} fill="#e8e4d0" /><path d={LEFT} fill="#bdb78f" /><path d={RIGHT} fill="#b2ac84" /><path d={BACK} fill="#cfc9a8" /><path d={FLOOR} fill="#9d9672" />
      <path d={WIN.weirdcore} fill="#6f6a4f" /><path d="M335 230 H365 V330 H335Z" fill="#2c2a20" />
      <path d="M600 540 V470 H690 V540 M600 470 V400 H690 V470" stroke="#7f7a5c" stroke-width="6" fill="none" transform="rotate(180 645 470)" />
      <rect x="110" y="480" width="40" height="60" fill="#7f7a5c" />
      <rect x="370" y="20" width="60" height="6" fill="#fffbe6" />
      <text x="470" y="470" class="rf-weird-caption">you have been here before</text>
    </g>
  )}

  <g class="rf-skeleton">
    <path d={`${BACK} M0 0 L230 140 M800 0 L570 140 M0 560 L230 390 M800 560 L570 390`} />
    <path d="M270 180 H430 V340 H270Z" />
    <path d="M590 540 H700 V400 H590Z M90 540 H180 V410 H90Z M400 0 V110" />
    <circle cx="400" cy="265" r="5" />
  </g>
</svg>
