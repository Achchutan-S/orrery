---
import type { GetStaticPaths } from 'astro';
import Layout from '../Layout.astro';
import Volume from '../components/Volume.astro';
import { shelves } from '../library.ts';

// Only shelves with volumes exist (validate.ts rejects an empty shelf); any other path is a 404.
export const getStaticPaths = (() => shelves.map((s) => ({ params: { shelf: s.id } }))) satisfies GetStaticPaths;
const shelf = shelves.find((s) => s.id === Astro.params.shelf)!;
const others = shelves.filter((s) => s.id !== shelf.id);
---
<Layout page="shelf" title={`${shelf.name} · The Claude Skills Archive`} description={shelf.blurb}>
  <nav class="trail" aria-label="Breadcrumb">
    <ol>
      <li><a href="/skills">The Archive</a></li>
      <li><a href={`/skills/shelf/${shelf.id}`} aria-current="page">{shelf.name}</a></li>
    </ol>
  </nav>
  <main id="main" class="alcove">
    <header class="alcove__head">
      <p class="plate__kicker">Shelf {shelf.call} · {shelf.skills.length} volume{shelf.skills.length === 1 ? '' : 's'}</p>
      <h1>{shelf.name}</h1>
      <p class="alcove__blurb">{shelf.blurb}</p>
    </header>
    <section class="shelf shelf--alcove" aria-label={`Volumes on ${shelf.name}`}>
      <div class="shelf__row">{shelf.skills.map((k) => <Volume skill={k} heading="h2" />)}</div>
    </section>
    <nav class="alcove__others" aria-labelledby="others-h">
      <h2 id="others-h">Other shelves</h2>
      <ul>{others.map((s) => <li><a class="chip" href={`/skills/shelf/${s.id}`}><span class="chip__call">{s.call}</span> {s.name} <span class="chip__n">{s.skills.length}</span></a></li>)}</ul>
      <p><a class="link-arrow link-arrow--back" href="/skills#stacks">Back to the stacks</a></p>
    </nav>
  </main>
</Layout>
