---
// One original file, shown exactly. The <code> element's text is the file, character for character:
// line numbers are CSS counters and highlighting is classes on line spans, so neither is part of the
// text, and Copy takes textContent (tested against the file in a real browser).
import type { PublishedFile } from '../library.ts';

interface Props { slug: string; file: PublishedFile; open?: boolean }
const { slug, file, open = false } = Astro.props;
const id = `src-${slug}-${file.path.replace(/[^a-z0-9]+/gi, '-').toLowerCase()}`;
const href = `/skills/${slug}/files/${file.path}`;
const name = file.path.split('/').at(-1)!;

const lines = file.text.split('\n');
const trailing = lines.at(-1) === '';
if (trailing) lines.pop();
const md = file.path.endsWith('.md');
const py = file.path.endsWith('.py');
let fenced = false;
let front = md && lines[0] === '---';
const kinds = lines.map((l, i) => {
  if (front) { if (i > 0 && l === '---') front = false; return 'k-front'; }
  if (md) {
    if (/^\s*(```|~~~)/.test(l)) { fenced = !fenced; return 'k-fence'; }
    if (fenced) return 'k-code';
    if (/^#{1,6}\s/.test(l)) return 'k-head';
    if (/^\s*>/.test(l)) return 'k-quote';
    if (/^\s*\|/.test(l)) return 'k-table';
    if (/^\s*([-*+]|\d+\.)\s/.test(l)) return 'k-list';
  }
  if (py) {
    if (/^\s*#/.test(l)) return 'k-comment';
    if (/^\s*(def|class)\s/.test(l)) return 'k-def';
    if (/^\s*("""|''')/.test(l)) return 'k-comment';
  }
  return '';
});
const short = `${file.sha256.slice(0, 12)}…`;
---
<details class="source" open={open} data-source-file>
  <summary class="source__summary">
    <span class="source__path"><code>{file.path}</code></span>
    <span class="source__facts">{file.lines} lines · {file.bytes.toLocaleString('en-GB')} bytes{file.edited && ' · edited for publication'}</span>
  </summary>
  {file.edited && <p class="source__note"><strong>Edited for publication.</strong> {file.edited.note} Original SHA-256: <code translate="no">{file.edited.originalSha256.slice(0, 12)}…</code></p>}
  <div class="source__bar">
    <button type="button" class="btn btn--brass" data-copy={id} data-label={file.path} hidden>Copy {name}</button>
    <a class="btn" href={href} download={name}>Download {name}</a>
    <a class="btn btn--quiet" href={href}>Open as plain text</a>
    <span class="source__hash" title={`SHA-256 ${file.sha256}`}>SHA-256 <code translate="no">{short}</code></span>
  </div>
  <div class="source__scroll" role="region" aria-label={`${file.path}, ${file.edited ? "copy edited for publication" : "original text"}`} tabindex="0">
    <pre class="code"><code id={id} data-text>{lines.map((l, i) => <Fragment><span class:list={['ln', kinds[i]]}>{l}</span>{i < lines.length - 1 || trailing ? '\n' : ''}</Fragment>)}</code></pre>
  </div>
  {file.sections.length > 1 && (
    <div class="source__sections" data-needs-js hidden>
      <p class="source__sections-title">Copy one section of <code>{file.path}</code></p>
      <ul>
        {file.sections.map((s) => <li><button type="button" class="chip" data-copy={id} data-range={`${s.start}:${s.end}`} data-label={`“${s.title}” from ${file.path}`}>{s.title}</button></li>)}
      </ul>
    </div>
  )}
</details>
