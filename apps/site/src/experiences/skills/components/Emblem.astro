---
// The device stamped on each artefact's cover: one small original drawing per skill, in currentColor.
interface Props { slug: string; class?: string }
const { slug, class: cls } = Astro.props;
---
<svg class:list={['emblem', cls]} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  {slug === 'conceptcast' && <g><path d="M8 14 h30 a4 4 0 0 1 4 4 v14 a4 4 0 0 1 -4 4 h-16 l-8 7 v-7 h-6 a4 4 0 0 1 -4 -4 v-14 a4 4 0 0 1 4 -4 z" /><path d="M46 26 h10 a4 4 0 0 1 4 4 v12 a4 4 0 0 1 -4 4 h-4 v6 l-7 -6 h-13 a4 4 0 0 1 -4 -4 v-2" /><circle cx="17" cy="25" r="1.6" /><circle cx="25" cy="25" r="1.6" /><circle cx="33" cy="25" r="1.6" /></g>}
  {slug === 'deep-dive-audio' && <g><path d="M10 32 v0 M16 26 v12 M22 18 v28 M28 23 v18 M34 12 v40 M40 20 v24 M46 26 v12 M52 30 v4" /><circle cx="32" cy="32" r="28" /></g>}
  {slug === 'interview-quick-answer' && <g><circle cx="32" cy="36" r="22" /><path d="M32 36 l9 -9 M28 8 h8 M32 8 v6 M50 16 l4 -4" /><path d="M32 22 v2 M46 36 h-2 M32 50 v-2 M18 36 h2" /></g>}
  {slug === 'system-design-prep' && <g><rect x="24" y="6" width="16" height="12" rx="1" /><rect x="6" y="44" width="16" height="12" rx="1" /><rect x="42" y="44" width="16" height="12" rx="1" /><rect x="24" y="26" width="16" height="10" rx="1" /><path d="M32 18 v8 M32 36 v4 H14 v4 M32 40 H50 v4" /></g>}
  {slug === 'wayfinder' && <g><circle cx="32" cy="32" r="26" /><path d="M32 10 l5 17 l17 5 l-17 5 l-5 17 l-5 -17 l-17 -5 l17 -5 z" /><circle cx="32" cy="32" r="3" /></g>}
  {slug === 'problem-finder' && <g><circle cx="26" cy="26" r="16" /><path d="M38 38 l18 18" /><path d="M26 18 v16 M21 21 q5 -3 9 1 q-9 4 0 8 q-4 4 -9 1" /></g>}
  {slug === 'india-product-gap-finder' && <g><circle cx="32" cy="32" r="26" /><ellipse cx="32" cy="32" rx="11" ry="26" /><path d="M6 32 h52 M10 19 h44 M10 45 h44" /><path d="M40 22 l4 4 l-4 4" /></g>}
  {slug === 'sidequest' && <g><path d="M32 6 l6 18 h19 l-15 11 l6 19 l-16 -11 l-16 11 l6 -19 l-15 -11 h19 z" /><path d="M32 30 q-8 -6 -6 -14 q8 4 6 14 q8 -8 14 -6 q-4 8 -14 6" /></g>}
  {slug === 'vedic-astrology-tamil' && <g><rect x="8" y="8" width="48" height="48" /><path d="M20 8 v48 M44 8 v48 M8 20 h48 M8 44 h48" /><path d="M20 20 h24 v24 h-24 z" /><circle cx="32" cy="32" r="5" /><path d="M14 14 l2 2 M50 50 l-2 -2" /></g>}
  {slug === 'moral-oratory' && <g><path d="M14 46 q18 10 36 0 q-2 6 -18 8 q-16 -2 -18 -8 z" /><path d="M32 46 v-6 M24 40 h16" /><path d="M32 36 q-8 -10 0 -24 q8 14 0 24 z" /><path d="M32 30 q-3 -4 0 -9 q3 5 0 9 z" /><path d="M20 58 h24" /></g>}
</svg>
