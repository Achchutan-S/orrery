---
// The reading room: an original illustration drawn as inline SVG, generated at build time from a
// fixed seed (the same room every build). Decorative only (aria-hidden); every colour is a CSS class
// so day and night are a stylesheet change, and no element carries an inline style (CSP).
// Layers move a few pixels with the pointer (archive.ts), never with reduced motion.
const rand = (() => { let s = 20261107; return () => { s = (s + 0x6d2b79f5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t ^= t + Math.imul(t ^ (t >>> 7), 61 | t); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; })();
const r = (a: number, b: number) => a + rand() * (b - a);
const n = (v: number) => Math.round(v * 10) / 10;

type Book = { x: number; y: number; w: number; h: number; c: number; lean: number; band: boolean };
type Shelf = { y: number; books: Book[]; trinket?: { x: number; kind: 'pot' | 'pile' } };
/** A bookcase's shelves of spines, between x0 and x1, standing on boards. */
function bookcase(x0: number, x1: number, top: number, rows: number, pitch: number): Shelf[] {
  return Array.from({ length: rows }, (_, k) => {
    const y = top + pitch * (k + 1);
    const books: Book[] = [];
    let x = x0 + r(2, 10);
    const gapAt = rand() < 0.55 ? r(x0 + 60, x1 - 90) : -1;
    let trinket: Shelf['trinket'];
    while (x < x1 - 14) {
      if (gapAt > 0 && !trinket && x > gapAt) { trinket = { x: n(x + 4), kind: rand() < 0.5 ? 'pot' : 'pile' }; x += 46; continue; }
      const w = r(11, 24); const h = r(pitch * 0.55, pitch * 0.86);
      if (x + w > x1 - 2) break;
      const lean = rand() < 0.08 ? -r(5, 11) : 0;
      books.push({ x: n(x), y: n(y - h), w: n(w), h: n(h), c: Math.floor(r(0, 8)), lean: n(lean), band: rand() < 0.6 });
      x += w + r(0.5, 2.5) + (lean ? 8 : 0);
    }
    return { y, books, trinket };
  });
}
const left = bookcase(52, 352, 168, 5, 118);
const right = bookcase(1250, 1550, 168, 5, 118);

/** Leaves along a drooping vine from (x, y), swaying sideways as it falls. */
function vine(x: number, y: number, length: number, sway: number, phase: number) {
  const pts = Array.from({ length: 24 }, (_, i) => { const t = i / 23; return { x: n(x + Math.sin(t * 5 + phase) * sway * t), y: n(y + t * length) }; });
  const d = `M${pts.map((p) => `${p.x} ${p.y}`).join(' L')}`;
  const leaves = pts.slice(2).filter((_, i) => i % 2 === 0).map((p, i) => ({ x: p.x + (i % 2 ? 7 : -7), y: p.y, a: i % 2 ? 38 : -38, s: n(r(0.75, 1.15)), alt: rand() < 0.4 }));
  return { d, leaves };
}
const vines = [vine(358, 150, 300, 22, 0.4), vine(1244, 150, 240, 18, 2.1), vine(470, 236, 120, 10, 1.3), vine(1128, 236, 150, 12, 0.2)];

const windows = [
  { x0: 465, x1: 655, ya: 236, yb: 640 },
  { x0: 685, x1: 915, ya: 196, yb: 640 },
  { x0: 945, x1: 1135, ya: 236, yb: 640 },
].map((w) => ({ ...w, rad: (w.x1 - w.x0) / 2, d: `M${w.x0} ${w.yb} V${w.ya} A${(w.x1 - w.x0) / 2} ${(w.x1 - w.x0) / 2} 0 0 1 ${w.x1} ${w.ya} V${w.yb} Z` }));

// The forest seen through the glass: crowns along a ridge.
const crowns = Array.from({ length: 34 }, (_, i) => ({ x: n(400 + i * 25 + r(-6, 6)), y: n(r(540, 572)), rx: n(r(16, 26)), ry: n(r(26, 46)) }));
const stars = Array.from({ length: 40 }, () => ({ x: n(r(470, 1130)), y: n(r(90, 470)), s: n(r(0.8, 2.2)) }));
const dust = Array.from({ length: 30 }, () => { const w = windows[Math.floor(r(0, 3))]!; return { x: n(r(w.x0 + 20, w.x1 + 160)), y: n(r(300, 800)), s: n(r(1.2, 3)) }; });
const floorLines = Array.from({ length: 20 }, (_, i) => { const x = i * 100 - 200; return { x1: x, x2: n(x + (x - 800) * 0.55) }; });
/** Fern fronds: arcs of leaflets from a pot at (x, y). */
function fern(x: number, y: number, fronds: number, size: number) {
  return Array.from({ length: fronds }, (_, k) => {
    const a = -150 + (120 / (fronds - 1)) * k + r(-6, 6);
    const rad = (a * Math.PI) / 180;
    const len = size * r(0.75, 1.05);
    const tip = { x: x + Math.cos(rad) * len, y: y + Math.sin(rad) * len * 0.9 };
    const mid = { x: x + Math.cos(rad) * len * 0.5, y: y + Math.sin(rad) * len * 0.5 - len * 0.18 };
    const leaflets = Array.from({ length: 9 }, (_, i) => {
      const t = (i + 1) / 10; const u = 1 - t;
      const px = u * u * x + 2 * u * t * mid.x + t * t * tip.x; const py = u * u * y + 2 * u * t * mid.y + t * t * tip.y;
      return { x: n(px), y: n(py), a: n(a + (i % 2 ? 60 : -60)), s: n(1.25 - t * 0.8) };
    });
    return { d: `M${x} ${y} Q${n(mid.x)} ${n(mid.y)} ${n(tip.x)} ${n(tip.y)}`, leaflets };
  });
}
const ferns = [fern(150, 802, 9, 150), fern(1468, 806, 7, 120)];
---
<svg class="scene" viewBox="-260 0 1860 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-scene>
  <defs>
    <linearGradient id="sg-wall" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="st-wall-a" /><stop offset="1" class="st-wall-b" /></linearGradient>
    <linearGradient id="sg-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="st-sky-a" /><stop offset="0.6" class="st-sky-b" /><stop offset="1" class="st-sky-c" /></linearGradient>
    <linearGradient id="sg-shaft" x1="0" y1="0" x2="0" y2="1"><stop offset="0" class="st-shaft-a" /><stop offset="1" class="st-shaft-b" /></linearGradient>
    <radialGradient id="sg-glow"><stop offset="0" class="st-glow-a" /><stop offset="1" class="st-glow-b" /></radialGradient>
    <radialGradient id="sg-vignette" cx="0.5" cy="0.45" r="0.75"><stop offset="0.55" class="st-vig-a" /><stop offset="1" class="st-vig-b" /></radialGradient>
    {windows.map((w, i) => <clipPath id={`sc-win${i}`}><path d={w.d} /></clipPath>)}
    <clipPath id="sc-windows">{windows.map((w) => <path d={w.d} />)}</clipPath>
  </defs>

  <g class="layer layer-0">
    <rect x="-260" width="1860" height="900" fill="url(#sg-wall)" />
    <g class="sc-vista" clip-path="url(#sc-windows)">
      <rect x="400" y="60" width="800" height="600" fill="url(#sg-sky)" />
      <g class="sc-stars">{stars.map((s) => <circle cx={s.x} cy={s.y} r={s.s} />)}</g>
      <circle class="sc-sun" cx="770" cy="214" r="38" />
      <path class="sc-moon" d="M770 176 A38 38 0 1 0 770 252 A30 38 0 1 1 770 176 Z" />
      <g class="sc-clouds"><ellipse cx="560" cy="300" rx="70" ry="16" /><ellipse cx="600" cy="288" rx="40" ry="18" /><ellipse cx="1030" cy="250" rx="80" ry="15" /><ellipse cx="1070" cy="238" rx="42" ry="16" /><ellipse cx="860" cy="360" rx="60" ry="12" /></g>
      <path class="sc-hill-far" d="M400 520 Q500 462 610 498 T820 470 T1010 492 T1200 458 V660 H400 Z" />
      <g class="sc-trees">{crowns.map((c) => <ellipse cx={c.x} cy={c.y} rx={c.rx} ry={c.ry} />)}</g>
      <path class="sc-hill-near" d="M400 600 Q560 572 760 596 T1200 588 V660 H400 Z" />
    </g>
    <rect class="sc-beam" x="-260" width="1860" height="44" />
    <rect class="sc-beam" x="410" y="44" width="16" height="746" />
    <rect class="sc-beam" x="1174" y="44" width="16" height="746" />
    {windows.map((w, i) => (
      <g>
        <path class="sc-glass" d={w.d} />
        <g clip-path={`url(#sc-win${i})`} class="sc-mullion">
          <line x1={(w.x0 + w.x1) / 2} y1="40" x2={(w.x0 + w.x1) / 2} y2={w.yb} />
          <line x1={w.x0} y1={w.ya} x2={w.x1} y2={w.ya} />
          <line x1={w.x0} y1={(w.ya + w.yb) / 2 + 30} x2={w.x1} y2={(w.ya + w.yb) / 2 + 30} />
        </g>
        <path class="sc-frame" d={w.d} />
        <rect class="sc-sill" x={w.x0 - 16} y={w.yb} width={w.x1 - w.x0 + 32} height="16" rx="3" />
      </g>
    ))}
    <g class="sc-sillpot"><path d="M500 640 l6 -26 h30 l6 26 z" /><g class="sc-leafy"><ellipse cx="512" cy="606" rx="12" ry="5" transform="rotate(-40 512 606)" /><ellipse cx="530" cy="602" rx="13" ry="5" transform="rotate(30 530 602)" /><ellipse cx="521" cy="596" rx="11" ry="4" transform="rotate(-80 521 596)" /></g></g>
    <g class="sc-sillbooks"><rect x="1062" y="626" width="52" height="14" rx="2" class="sc-b3" /><rect x="1066" y="614" width="44" height="12" rx="2" class="sc-b6" /></g>
  </g>

  <g class="layer layer-1">
    {[{ x: 30, shelves: left }, { x: 1228, shelves: right }].map((c) => (
      <g>
        <rect class="sc-case" x={c.x} y="150" width="344" height="640" />
        <rect class="sc-crown" x={c.x - 12} y="128" width="368" height="24" rx="3" />
        <rect class="sc-case-back" x={c.x + 18} y="168" width="308" height="604" />
        {c.shelves.map((s) => (
          <g>
            {s.books.map((b) => (
              <g transform={b.lean ? `rotate(${b.lean} ${b.x + b.w} ${s.y})` : undefined}>
                <rect class={`sc-b${b.c}`} x={b.x} y={b.y} width={b.w} height={b.h} rx="1.5" />
                {b.band && <rect class="sc-band" x={b.x} y={b.y + 8} width={b.w} height="3" />}
                {b.band && <rect class="sc-band" x={b.x} y={b.y + b.h - 12} width={b.w} height="3" />}
              </g>
            ))}
            {s.trinket?.kind === 'pot' && (
              <g class="sc-sillpot"><path d={`M${s.trinket.x} ${s.y} l4 -20 h24 l4 20 z`} /><g class="sc-leafy"><ellipse cx={s.trinket.x + 9} cy={s.y - 26} rx="10" ry="4" transform={`rotate(-45 ${s.trinket.x + 9} ${s.y - 26})`} /><ellipse cx={s.trinket.x + 24} cy={s.y - 28} rx="10" ry="4" transform={`rotate(40 ${s.trinket.x + 24} ${s.y - 28})`} /><ellipse cx={s.trinket.x + 16} cy={s.y - 34} rx="9" ry="4" transform={`rotate(-85 ${s.trinket.x + 16} ${s.y - 34})`} /></g></g>
            )}
            {s.trinket?.kind === 'pile' && (
              <g><rect class="sc-b2" x={s.trinket.x} y={s.y - 10} width="38" height="10" rx="1.5" /><rect class="sc-b5" x={s.trinket.x + 3} y={s.y - 19} width="33" height="9" rx="1.5" /><rect class="sc-b7" x={s.trinket.x + 1} y={s.y - 27} width="35" height="8" rx="1.5" /></g>
            )}
            <rect class="sc-board" x={c.x + 18} y={s.y} width="308" height="12" />
          </g>
        ))}
      </g>
    ))}
    <g class="sc-ladder">
      <line x1="1300" y1="140" x2="1250" y2="800" /><line x1="1352" y1="140" x2="1310" y2="800" />
      {Array.from({ length: 11 }, (_, i) => { const t = (i + 0.6) / 11.5; return <line x1={n(1300 - 50 * t)} y1={n(140 + 660 * t)} x2={n(1352 - 42 * t)} y2={n(140 + 660 * t)} />; })}
    </g>
    {vines.map((v) => (
      <g class="sc-vine"><path d={v.d} />{v.leaves.map((l) => <ellipse class={l.alt ? 'sc-leaf2' : 'sc-leaf'} cx={l.x} cy={l.y} rx={n(9 * l.s)} ry={n(4.5 * l.s)} transform={`rotate(${l.a} ${l.x} ${l.y})`} />)}</g>
    ))}
    {[672, 930].map((x, i) => (
      <g class="sc-lantern">
        <circle class="sc-glow" cx={x} cy={292 + i * 16} r="120" fill="url(#sg-glow)" />
        <line class="sc-chain" x1={x} y1="44" x2={x} y2={262 + i * 16} />
        <path class="sc-brass" d={`M${x - 16} ${266 + i * 16} h32 l-6 -8 h-20 z`} />
        <rect class="sc-lantern-glass" x={x - 13} y={268 + i * 16} width="26" height="40" rx="6" />
        <path class="sc-brass" d={`M${x - 15} ${308 + i * 16} h30 l-5 7 h-20 z`} />
      </g>
    ))}
    <rect class="sc-trim" x="-260" y="782" width="1860" height="10" />
    <rect class="sc-floor" x="-260" y="790" width="1860" height="110" />
    {floorLines.map((l) => <line class="sc-floorline" x1={l.x1} y1="790" x2={l.x2} y2="900" />)}
    <ellipse class="sc-rug" cx="800" cy="858" rx="380" ry="48" />
    <ellipse class="sc-rug-border" cx="800" cy="858" rx="350" ry="38" />

    <g class="sc-shafts">
      {windows.map((w) => <polygon class="sc-shaft" points={`${w.x0 + 12},${w.ya - 30} ${w.x1 - 12},${w.ya - 30} ${w.x1 + 230},900 ${w.x0 + 130},900`} fill="url(#sg-shaft)" />)}
    </g>
    <g class="sc-dust">{dust.map((d) => <circle cx={d.x} cy={d.y} r={d.s} />)}</g>

    <g class="sc-desk-group">
      <circle class="sc-glow sc-lamp-glow" cx="690" cy="650" r="150" fill="url(#sg-glow)" />
      <rect class="sc-desk-top" x="600" y="712" width="400" height="16" rx="3" />
      <rect class="sc-desk" x="618" y="728" width="364" height="48" />
      <rect class="sc-desk" x="626" y="776" width="18" height="74" /><rect class="sc-desk" x="956" y="776" width="18" height="74" />
      <circle class="sc-brass" cx="720" cy="752" r="4" /><circle class="sc-brass" cx="880" cy="752" r="4" />
      <ellipse class="sc-brass" cx="660" cy="711" rx="22" ry="5" />
      <path class="sc-lamp-arm" d="M660 710 V650 Q660 628 684 626" />
      <path class="sc-brass" d="M672 640 L686 610 h18 L716 640 Z" />
      <rect class="sc-bookcover" x="706" y="704" width="188" height="9" rx="2" />
      <path class="sc-page" d="M800 708 C780 690 744 688 712 696 L712 708 Z" />
      <path class="sc-page" d="M800 708 C820 690 856 688 888 696 L888 708 Z" />
      <g class="sc-pageline"><line x1="724" y1="699" x2="788" y2="696" /><line x1="724" y1="703" x2="790" y2="701" /><line x1="812" y1="696" x2="876" y2="699" /><line x1="810" y1="701" x2="876" y2="703" /></g>
      <path class="sc-ribbon" d="M804 708 v24 l-4 -5 l-4 5 v-24 z" />
      <g class="sc-cup"><path d="M902 712 h28 v-6 q0 -16 -14 -16 q-14 0 -14 16 z" /><ellipse cx="916" cy="712" rx="20" ry="3" /></g>
      <g class="sc-steam"><path d="M910 684 q-6 -10 0 -18 q6 -8 0 -16" /><path d="M920 682 q-6 -10 0 -18 q6 -8 0 -16" /></g>
      <rect class="sc-b1" x="938" y="700" width="50" height="12" rx="2" /><rect class="sc-b4" x="942" y="689" width="44" height="11" rx="2" /><rect class="sc-b6" x="940" y="679" width="47" height="10" rx="2" />
      <g class="sc-owl">
        <path class="sc-owl-body" d="M944 680 q-6 -44 19 -52 q25 8 19 52 z" />
        <path class="sc-owl-body" d="M948 634 l-5 -12 l11 8 z M978 634 l5 -12 l-11 8 z" />
        <ellipse class="sc-owl-belly" cx="963" cy="664" rx="11" ry="14" />
        <circle class="sc-owl-face" cx="956" cy="645" r="8" /><circle class="sc-owl-face" cx="970" cy="645" r="8" />
        <g class="sc-owl-eyes"><circle cx="956" cy="645" r="3.4" /><circle cx="970" cy="645" r="3.4" /></g>
        <g class="sc-owl-lids"><ellipse cx="956" cy="645" rx="5" ry="5" /><ellipse cx="970" cy="645" rx="5" ry="5" /></g>
        <path class="sc-owl-beak" d="M963 649 l-2.5 3 l2.5 4 l2.5 -4 z" />
        <path class="sc-leaf" d="M963 626 q-2 -10 6 -14 q-1 9 -6 14 z" />
      </g>
    </g>
  </g>

  <g class="layer layer-2">
    {[{ x: 150, y: 802 }, { x: 1468, y: 806 }].map((p) => <path class="sc-pot" d={`M${p.x - 40} ${p.y} l10 70 h60 l10 -70 z`} />)}
    {ferns.map((f) => f.map((fr) => (
      <g class="sc-frond"><path d={fr.d} />{fr.leaflets.map((l) => <ellipse class="sc-leaf" cx={l.x} cy={l.y} rx={n(12 * l.s)} ry={n(4 * l.s)} transform={`rotate(${l.a} ${l.x} ${l.y})`} />)}</g>
    )))}
  </g>
  <rect class="sc-vignette" x="-260" width="1860" height="900" fill="url(#sg-vignette)" />
</svg>
