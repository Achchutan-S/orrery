{
  "name": "@pu/control",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "vite build && vite preview",
    "dev": "node server/main.ts",
    "dev:web": "vite",
    "test": "node --test --test-reporter=spec \"server/**/*.test.ts\" \"web/**/*.test.ts\"",
    "test:browser": "mkdir -p test-results && node --test --test-concurrency=1 --test-reporter=spec \"test-browser/**/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@pu/experience-catalog": "workspace:*",
    "@pu/platform-schema": "workspace:*",
    "hono": "4.13.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "vite": "8.3.5"
  }
}
